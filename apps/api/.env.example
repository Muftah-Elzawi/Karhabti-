# Karhabti API — copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3001

# Infrastructure (matches docker-compose.yml at the repo root)
DATABASE_URL=postgresql://karhabti:karhabti@localhost:5432/karhabti
REDIS_URL=redis://localhost:6379

# Auth (Phase 1, Step 5)
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Observability (Phase 1, Step 4)
SENTRY_DSN=
