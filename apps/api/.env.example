# Karhabti API — copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3001

# Infrastructure (matches docker-compose.yml at the repo root)
DATABASE_URL=postgresql://karhabti:karhabti@localhost:5432/karhabti
REDIS_URL=redis://localhost:6379

# Auth — generate real secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Observability
SENTRY_DSN=

# Comma-separated allowed browser origins (web + admin)
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
