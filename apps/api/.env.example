# Karhabti API — copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3001

# Infrastructure (matches docker-compose.yml at the repo root)
DATABASE_URL=postgresql://karhabti:karhabti@localhost:5432/karhabti
REDIS_URL=redis://localhost:6379

# Auth — generate real secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Observability
SENTRY_DSN=

# Comma-separated allowed browser origins (web + admin)
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Payments — Plutu. Leave PLUTU_MODE=sandbox for local dev: the in-process mock
# gateway accepts PLUTU_SANDBOX_OTP as the wallet OTP and signs/expects webhook
# callbacks with HMAC-SHA256(rawBody, PLUTU_WEBHOOK_SECRET). Switch to `live`
# (and fill the credentials) only with a real, approved merchant account.
PLUTU_MODE=sandbox
PLUTU_BASE_URL=https://api.plutu.ly/api/v1
PLUTU_API_KEY=
PLUTU_API_SECRET=
PLUTU_ACCESS_TOKEN=
PLUTU_WEBHOOK_SECRET=plutu-sandbox-webhook-secret
PLUTU_SANDBOX_OTP=123456
