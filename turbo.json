{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "@karhabti/database#build": {
      "cache": false
    },
    "@karhabti/database#typecheck": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/standalone/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
